# ============================================================
# Tranquilo Vacation Rentals — Environment Variables Example
# Copy this file to .env.local and fill in your values.
# ============================================================

# Site
NEXT_PUBLIC_SITE_URL=https://www.tranquilovacationrentals.com
NEXT_PUBLIC_SITE_NAME=Tranquilo Vacation Rentals

# Stripe — Direct Booking
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Resend — Transactional Email
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@tranquilovacationrentals.com
RESEND_REPLY_TO=bookings@tranquilovacationrentals.com

# Cloudflare Turnstile — Anti-spam
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...
TURNSTILE_SECRET_KEY=0x...

# Upstash Redis — Rate Limiting
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER=+15005550006

# Google Analytics (optional — Vercel Analytics is primary)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-...

# OTA Links (used as secondary CTA buttons)
NEXT_PUBLIC_AIRBNB_PROFILE_URL=https://www.airbnb.com/users/...
NEXT_PUBLIC_VRBO_PROFILE_URL=https://www.vrbo.com/...

# iCal import — base URL for property iCal feeds (optional)
ICAL_BASE_URL=https://www.airbnb.com/calendar/ical/

# Node environment
NODE_ENV=development
